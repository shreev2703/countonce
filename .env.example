# Copy to .env and fill in. Never commit real values (.env is git-ignored).
# tests/test_env_example.py fails if the code reads a variable that is not listed here.

# --- VLM benchmark baselines (bench/vlm); only needed for paid runs ---
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# --- GPU memory (countonce/oom.py appends expandable_segments:True if unset) ---
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- CI metadata (set by GitHub Actions; read by bench/golden.py for the result file name) ---
GITHUB_SHA=

# Postgres job store (`--store postgres`, db extra); also enables the Postgres contract tests
# COUNTONCE_PG_URL=postgresql://user:pass@localhost:5432/countonce
COUNTONCE_PG_URL=

# --- Object storage (countonce/storage; `storage` extra for s3) ---
# local (default) keeps files on disk; s3 works with AWS S3, Cloudflare R2 or MinIO.
COUNTONCE_STORAGE=local
# local backend: root directory and the secret that signs local URLs (random per process if empty)
COUNTONCE_STORAGE_DIR=
COUNTONCE_STORAGE_SECRET=
# s3 backend: bucket required; endpoint for R2 is https://<account-id>.r2.cloudflarestorage.com
COUNTONCE_S3_BUCKET=
COUNTONCE_S3_ENDPOINT_URL=
COUNTONCE_S3_REGION=
COUNTONCE_S3_ACCESS_KEY_ID=your-r2-access-key-id
COUNTONCE_S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
COUNTONCE_S3_PREFIX=
