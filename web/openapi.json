          },
          "correct": {
            "title": "Correct",
            "type": "boolean"
          },
          "user_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Count"
          }
        },
        "required": [
          "correct"
        ],
        "title": "FeedbackIn",
        "type": "object"
      },
